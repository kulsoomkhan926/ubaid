   "source": [
    "# Student result calculator\n",
    "\n",
    "# Create variables\n",
    "name = \"Ahmed\"\n",
    "math = 85\n",
    "english = 72\n",
    "python = 90\n",
    "total_possible_per_subject = 100\n",
    "passing_marks = 50\n",
    "letter_to_check = \"A\"\n",
    "\n",
    "# 1. Calculate total marks\n",
    "total_marks = math + english + python\n",
    "\n",
    "# 2. Calculate average marks\n",
    "average_marks = total_marks / 3\n",
    "\n",
    "# 3. Calculate percentage\n",
    "percentage = (total_marks / (total_possible_per_subject * 3)) * 100\n",
    "\n",
    "# 4. Check whether student passed Mathematics\n",
    "passed_math = math >= passing_marks\n",
    "\n",
    "# 5. Check whether student passed all three subjects\n",
    "passed_all = (math >= passing_marks) and (english >= passing_marks) and (python >= passing_marks)\n",
    "\n",
    "# 6. Check whether name contains the letter \"A\"\n",
    "name_contains_A = letter_to_check in name\n",
    "\n",
    "# 7. Check whether average marks are >= 80\n",
    "average_above_80 = average_marks >= 80\n",
    "\n",
    "# 8. Store final percentage and check if it is truthy\n",
    "final_percentage = percentage\n",
    "percentage_truthy = bool(final_percentage)\n",
    "\n",
    "# Print all results\n",
    "print(\"Student Name:\", name)\n",
    "print(\"Mathematics:\", math)\n",
    "print(\"English:\", english)\n",
    "print(\"Python:\", python)\n",
    "print(\"Total Marks:\", total_marks)\n",
    "print(\"Average Marks:\", round(average_marks, 2))\n",
    "print(\"Percentage:\", round(percentage, 2), \"%\")\n",
    "print(\"Passed Mathematics:\", passed_math)\n",
    "print(\"Passed All Subjects:\", passed_all)\n",
    "print(\"Name contains 'A':\", name_contains_A)\n",
    "print(\"Average >= 80:\", average_above_80)\n",
    "print(\"Final Percentage is truthy:\", percentage_truthy)"
