     "output_type": "stream",
     "text": [
      "Student Name: Ahmed\n",
      "Mathematics: 85\n",
      "English: 72\n",
      "Python: 90\n",
      "Total Marks: 247\n",
      "Average Marks: 82.33\n",
      "Percentage: 82.33 %\n",
      "Passed Mathematics: True\n",
      "Passed All Subjects: True\n",
      "Name contains 'A': True\n",
      "Average >= 80: True\n",
      "Final Percentage is truthy: True\n"
     ]
